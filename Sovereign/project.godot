; Sovereign: The Industrial Century — Godot 4.5.1 .NET.
config_version=5

[application]

config/name="Sovereign — The Industrial Century"
config/icon="res://Assets/art/icon.svg"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "C#", "Forward Plus")

[display]

window/size/viewport_width=1600
window/size/viewport_height=1000
window/size/window_width_override=1600
window/size/window_height_override=1000
window/size/min_width=1120
window/size/min_height=630
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Sovereign"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
textures/default_filters/anisotropic_filtering_level=3
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.027, 0.059, 0.082, 1)
